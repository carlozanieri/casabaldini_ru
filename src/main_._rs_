// Definiamo la struttura dati per la tabella
#[derive(Serialize, FromRow)]
struct Links{
	id:          i32,
	codice:      String,
	img:         String,
	titolo:      String,
	attivo:      i32,
	descrizione: String,
	link:        String,
	height:      String,
	width:       String,
}
#[derive(Serialize, FromRow)]
struct Slider {
     id: i64,
     codice: String,
     codice2: String, // O String, a seconda del tuo DB
     img: String,
     titolo: String,
     caption: String,
     link: String,
     testo: String,
}
