#[derive(Serialize, FromRow)]
struct Menus {
	id:       i64,
	codice:   String,
	radice:   String,
	livello:  i64,
	titolo:   String,
	link:     String,
	
}
#[derive(Serialize, FromRow)]
struct Submenus{
	id:       i64,
	codice:   String,
	radice:   String,
	livello:  i64,
	titolo:   String,
	link:     String,
	
}
struct AppState {
    db: SqlitePool,
    tera: tera::Tera,
    templates: Tera,
    
}

#[derive(Serialize)]
struct BaseContext {
    menu: Vec<Menus>,
    submenu: Vec<Submenus>,
    links: Vec<Links>,
    
    // Puoi aggiungere altri dati globali qui, come il titolo del sito
}
#[derive(Serialize)]
struct BaseContexts {
    slide: Vec<Slider>,
    
    // Puoi aggiungere altri dati globali qui, come il titolo del sito
}
